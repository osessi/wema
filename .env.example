# Copiez ce fichier en .env pour le développement local. Ne commitez jamais .env.

# Postgres. Laissez vide en développement : l'API utilise alors une base
# PGlite locale (apps/api/.data/pglite), sans Docker.
DATABASE_URL=
# Exemple avec le Postgres de infra/docker-compose.yml :
# DATABASE_URL=postgres://wema:wema@localhost:5432/wema
# Connexions Postgres au plus par serveur (20 par défaut).
DATABASE_POOL_MAX=

# Secret qui signe les codes envoyés par téléphone (obligatoire en production).
WEMA_CODE_SECRET=

# Clé de chiffrement des données de santé : 32 octets en base64 (obligatoire en production).
# Exemple pour en créer une : openssl rand -base64 32
WEMA_HEALTH_KEY=

# Adresse de services/math (vérification des exercices).
WEMA_MATH_URL=http://localhost:8000

# Passerelle IA : clé OpenRouter (https://openrouter.ai/keys). Sans elle, l'IA n'est pas disponible.
OPENROUTER_API_KEY=

# Adresse du web (back-office).
WEMA_PUBLIC_URL=http://localhost:3000

# Premier super admin, créé au démarrage s'il n'en existe aucun.
WEMA_SUPER_ADMIN_EMAIL=
WEMA_SUPER_ADMIN_PASSWORD=
WEMA_SUPER_ADMIN_NAME=Super admin

# Connexion Google et Apple (facultatif).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Envois (codes de connexion, relances, messagerie). Tout est facultatif : sans
# prestataire, les messages s'affichent dans la console de l'API en développement
# et le canal est indisponible en production.
# Twilio (SMS et WhatsApp) : https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Clé d'API facultative (SK…) : TWILIO_AUTH_TOKEN contient alors son secret.
TWILIO_API_KEY_SID=
# Expéditeur des SMS : numéro E.164 ou service de messagerie (MG…).
TWILIO_SMS_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# Numéro WhatsApp Business (E.164, sans « whatsapp: »).
TWILIO_WHATSAPP_FROM=
# Modèles WhatsApp approuvés (HX…) : code de connexion ({{1}} = code) et
# notification ({{1}} = texte). Obligatoires hors fenêtre de 24 h de conversation.
TWILIO_WHATSAPP_CODE_CONTENT_SID=
TWILIO_WHATSAPP_NOTIFICATION_CONTENT_SID=
# Vonage (SMS et WhatsApp, Messages API) : https://dashboard.nexmo.com
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_SMS_FROM=
VONAGE_WHATSAPP_FROM=
VONAGE_WHATSAPP_CODE_TEMPLATE=
VONAGE_WHATSAPP_NOTIFICATION_TEMPLATE=
VONAGE_WHATSAPP_TEMPLATE_LOCALE=
# Prestataire préféré quand les deux sont configurés (twilio ou vonage ; défaut : twilio).
WEMA_SMS_PROVIDER=
WEMA_WHATSAPP_PROVIDER=
# E-mail par Resend : https://resend.com (expéditeur d'un domaine vérifié).
RESEND_API_KEY=
WEMA_EMAIL_FROM=
WEMA_EMAIL_REPLY_TO=
# Notifications push de l'appli mobile (service Expo, sans compte). Facultatif :
# jeton d'accès si la « sécurité renforcée des envois » est activée sur expo.dev.
EXPO_ACCESS_TOKEN=

# Paiement (fiche 0009). Tout est facultatif : sans clé, en développement, un
# faux fournisseur simule un paiement réussi ; en production, le moyen de
# paiement est indisponible. Prix, devises et pays se règlent dans /admin/offres.
# Stripe (carte) : https://dashboard.stripe.com/apikeys ; webhook vers
# <adresse publique>/api/billing/webhooks/stripe, événements checkout.session.*,
# invoice.paid, invoice.payment_failed, customer.subscription.deleted.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Kkiapay (Mobile Money) : https://app.kkiapay.me (clés API) ; webhook vers
# <adresse publique>/api/billing/webhooks/kkiapay, avec un secret partagé.
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET_KEY=
KKIAPAY_WEBHOOK_SECRET=
# true pour l'environnement de test de Kkiapay (sandbox).
KKIAPAY_SANDBOX=
# Visio des séances avec le prof (agenda) : domaine Jitsi Meet des salles.
# Vide : meet.jit.si (public). Un domaine Jitsi auto-hébergé ou JaaS sinon.
WEMA_JITSI_DOMAIN=
# Web : 1 pour proposer la visio intégrée à la page (iframe). Exige d'autoriser
# le domaine Jitsi dans apps/web/next.config.ts (frame-src, Permissions-Policy).
WEMA_VISIO_EMBED=
