# Production Wema : copiez ce fichier en infra/.env (jamais commité) et
# renseignez chaque valeur. Mode d'emploi : docs/deploiement.md.

# Nom de domaine de Wema (sans https://), déjà pointé vers l'adresse IP du serveur.
WEMA_DOMAIN=
# E-mail pour les certificats HTTPS (Let's Encrypt prévient en cas de souci).
ACME_EMAIL=

# Mot de passe de la base (long et aléatoire) : openssl rand -hex 24
POSTGRES_PASSWORD=
# Secret des codes envoyés par téléphone (32 caractères au moins) : openssl rand -hex 32
WEMA_CODE_SECRET=
# Clé de chiffrement des données de santé (32 octets en base64) : openssl rand -base64 32
# À GARDER PRÉCIEUSEMENT : sans elle, les données de santé sauvegardées sont illisibles.
WEMA_HEALTH_KEY=

# Passerelle IA (https://openrouter.ai/keys). Sans elle, l'IA n'est pas disponible.
OPENROUTER_API_KEY=

# Premier super admin, créé au premier démarrage (mot de passe : 12 caractères au moins).
WEMA_SUPER_ADMIN_EMAIL=
WEMA_SUPER_ADMIN_PASSWORD=
WEMA_SUPER_ADMIN_NAME=Super admin

# Tout le reste est lu par l'API tel quel : prestataires d'envoi (SMS,
# WhatsApp, e-mail), visio, paiements… Recopiez ici, depuis .env.example à la
# racine du dépôt, les variables des prestataires que vous activez.

# Connexion Google et Apple (facultatif).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Sauvegardes : heure (UTC) et durée de conservation en jours.
BACKUP_AT=03:00
BACKUP_KEEP_DAYS=14
