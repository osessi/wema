{
  "name": "@wema/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/seed.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run --passWithNoTests",
    "ai:check": "tsx --env-file-if-exists=../../.env src/ai-check.ts",
    "evals": "tsx --env-file-if-exists=../../.env src/evals-run.ts",
    "seed:demo": "tsx --env-file-if-exists=../../.env src/seed-demo.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-validator": "^0.9.1",
    "@wema/access": "workspace:*",
    "@wema/ai-gateway": "workspace:*",
    "@wema/curriculum": "workspace:*",
    "@wema/db": "workspace:*",
    "@wema/domain": "workspace:*",
    "@wema/exercises": "workspace:*",
    "@wema/learner-model": "workspace:*",
    "@wema/orchestrator": "workspace:*",
    "@wema/tutor": "workspace:*",
    "arctic": "^3.7.0",
    "hono": "^4.13.16",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15"
  }
}
