nk":"Créer un exercice","addSubmit":"Déposer","generate":{"button":"Demander des propositions à l'IA","pending":"L'IA prépare ses propositions…","pendingHint":"L'IA rédige des exercices pour les notions de vos classes, puis chacun est vérifié par le calcul. Cela peut prendre jusqu'à une minute.","result":"{proposed, plural, =0 {Aucune proposition vérifiée cette fois} one {# proposition vérifiée ajoutée} other {# propositions vérifiées ajoutées}}{rejected, plural, =0 {.} one { · # écartée par le contrôle.} other { · # écartées par le contrôle.}}","resultHint":"Les propositions de l'IA apparaissent ci-dessous, « À trier » : retenez celles qui conviennent.","noNotion":"Aucune notion à alimenter : vos classes n'ont pas de programme, ou leurs notions ont déjà leurs propositions cette semaine.","partial":"{failed, plural, one {L'IA n'a pas répondu pour # notion.} other {L'IA n'a pas répondu pour # notions.}} Vous pouvez réessayer.","rejectedTitle":"Voir les propositions écartées","untitled":"Sans titre","reasons":{"invalid_format":"format incorrect","duplicate":"en double","no_valid_parameters":"aucun jeu de nombres ne convient","check_failed":"refusée par la vérification du calcul","unknown_placeholder":"énoncé incomplet","math_unavailable":"service de calcul indisponible","other":"non retenue"},"ai_not_configured":"L'IA n'est pas configurée sur ce serveur : les propositions automatiques sont indisponibles.","ai_unavailable":"L'IA est indisponible pour le moment. Réessayez dans quelques minutes.","error":"Les propositions n'ont pas pu être préparées. Réessayez."},"steps":{"label":"Avancement de la banque","propose":"Propositions","sort":"Tri","give":"Devoirs"},"selectedToast":"Exercice retenu.","rejectedToast":"Exercice écarté.","entries":"{count, plural, one {# exercice} other {# exercices}}","emptyFilterHint":"Changez de catégorie pour voir les autres exercices de la semaine."}},"tutoring":{"register":{"teacher":"Prof particulier","teacherHint":"Je crée mon espace, mes