ir toutes les organisations"},"roles":{"manage":"Gérer les rôles"},"members":{"manage":"Gérer les membres"},"audit":{"read":"Consulter le journal d'audit"},"exercises":{"read":"Consulter les exercices","write":"Créer et attribuer des exercices"},"ai":{"manage":"Régler les modèles d'IA et voir leurs coûts"},"contacts":{"manage":"Lire et traiter les demandes de contact"},"diagnostic":{"conduct":"Mener les rendez-vous de diagnostic (conseiller Wema)"},"learners":{"read":"Consulter le profil des élèves","write":"Déclarer les préférences des élèves","health":{"read":"Consulter les besoins particuliers déclarés (santé)","write":"Déclarer des besoins particuliers (santé, avec consentement)"}},"classes":{"manage":"Créer les classes et y affecter profs et élèves"}},"members":{"title":"Membres","none":"Aucun membre pour l'instant.","new":"Ajouter un membre","displayName":"Nom affiché","role":"Rôle","roles":"Rôles","login":"Moyen de connexion","loginKinds":{"email":"E-mail","phone":"Téléphone","username":"Identifiant élève + code"},"loginKindsHint":{"email":"La personne ne doit pas déjà avoir un compte Wema avec cette adresse.","phone":"La personne se connectera avec un code reçu par SMS ou WhatsApp.","username":"Pour un élève sans e-mail ni téléphone. Un code de connexion est généré : notez-le, il n'est montré qu'une fois."},"email":"E-mail","password":"Mot de passe initial (facultatif)","passwordHint":"Au moins 10 caractères. Sans mot de passe, la personne pourra se connecter avec Google ou Apple si l'adresse correspond.","phone":"Téléphone (format international)","username":"Identifiant","usernameHint":"3 à 32 caractères : lettres, chiffres, point, tiret.","loginCode":"Code de connexion de {name} : {code}","loginCodeHint":"Notez-le maintenant : il ne sera plus affiché.","newLoginCode":"Nouveau code","addRole":"Ajouter un rôle","removeRole":"Retirer ce rôle","identities":"Connexion","disabled":"Compte désactivé","removeRoleConfirm":"Retirer le rôle « {role} » à {name} ?","re