# Adresse du serveur API Wema vue depuis le téléphone (sans /api à la fin).
# Vide en développement : l'appli prend l'adresse de l'ordinateur qui fait
# tourner Expo, port 4000 (téléphone et ordinateur sur le même réseau Wi-Fi).
EXPO_PUBLIC_WEMA_API_URL=
# Adresse de l'application web, AVEC le chemin /app (pages légales : conditions,
# confidentialité), ex. https://wema.winneragency.co/app. L'API, elle, est à la
# racine : EXPO_PUBLIC_WEMA_API_URL=https://wema.winneragency.co (sans /api).
# Vide en développement : l'ordinateur qui fait tourner Expo, port 3000, /app.
EXPO_PUBLIC_WEMA_WEB_URL=
